<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.druvu</groupId>
		<artifactId>druvu-lib-excel</artifactId>
		<version>2.0.0-SNAPSHOT</version>
	</parent>

	<artifactId>druvu-lib-excel-writer</artifactId>
	<packaging>jar</packaging>

	<name>druvu-lib-excel-writer</name>
	<description>Excel reports from plain Java: every column of a sheet declared in one place</description>

	<properties>
		<!-- Test-only: the independent reader -->
		<poi.version>6.0.0</poi.version>
		<commons-io.version>2.22.0</commons-io.version>
		<commons-codec.version>1.23.0</commons-codec.version>
	</properties>

	<dependencies>
		<!-- EXCEL: the one runtime dependency - small, streaming, a real module. The public API never
		     exposes a fastexcel type. -->
		<dependency>
			<groupId>org.dhatim</groupId>
			<artifactId>fastexcel</artifactId>
		</dependency>

		<!-- TEST -->
		<!-- POI is the independent reader: every test reads the written file back with it, so the library is never
		     verified by the code that produced the file. POI's own tree disagrees with itself on commons-io and
		     commons-codec, which fails dependencyConvergence, so the two are excluded from the POI subtree and owned
		     below, one version each. Own only what diverges - re-measure on every POI bump. -->
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>${poi.version}</version>
			<scope>test</scope>
			<exclusions>
				<exclusion>
					<groupId>commons-io</groupId>
					<artifactId>commons-io</artifactId>
				</exclusion>
				<exclusion>
					<groupId>commons-codec</groupId>
					<artifactId>commons-codec</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>commons-io</groupId>
			<artifactId>commons-io</artifactId>
			<version>${commons-io.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>commons-codec</groupId>
			<artifactId>commons-codec</artifactId>
			<version>${commons-codec.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testng</groupId>
			<artifactId>testng</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

</project>
